rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && (!('nickname' in request.resource.data)
            || (request.resource.data.nickname is string
                && request.resource.data.nickname.size() >= 2
                && request.resource.data.nickname.size() <= 20))
        && (!('photoURL' in request.resource.data)
            || (request.resource.data.photoURL is string
                && request.resource.data.photoURL.size() < 200000));
      allow delete: if false;

      match /attempts/{attemptId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= request.resource.data.total
          && request.resource.data.total <= 10;
        allow update, delete: if false;
      }

      match /mistakes/{mistakeId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
